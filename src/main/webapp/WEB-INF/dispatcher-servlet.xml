<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:security="http://www.springframework.org/schema/security"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx.xsd
           http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security.xsd
           http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Scan for controllers, services, DAOs, and security utilities -->
    <context:component-scan base-package="com.example" />

    <!-- Enable method-level security with @PreAuthorize -->
    <security:global-method-security pre-post-annotations="enabled" />

    <!-- ===== PUBLIC ENDPOINTS (No Security) ===== -->
    <security:http pattern="/login" security="none"/>
    <security:http pattern="/register" security="none"/>
    <security:http pattern="/auth/login" security="none"/>
    <security:http pattern="/auth/register" security="none"/>
    <security:http pattern="/static/**" security="none"/>
    <security:http pattern="/css/**" security="none"/>
    <security:http pattern="/js/**" security="none"/>
    <security:http pattern="/images/**" security="none"/>
    
    <!-- ===== PROTECTED ENDPOINTS (JWT Required) ===== -->
    <security:http entry-point-ref="jwtAuthEntryPoint" 
                   create-session="stateless" 
                   authentication-manager-ref="authenticationManager" 
                   use-expressions="true">
        
        <!-- JWT Filter - Executes before form login -->
        <security:custom-filter ref="jwtFilter" before="FORM_LOGIN_FILTER"/>
        
        <!-- Allow home page -->
        <security:intercept-url pattern="/" access="permitAll"/>
        
        <!-- ===== JSP VIEW PAGES (Frontend will check localStorage) ===== -->
        <security:intercept-url pattern="/admin-dashboard" access="permitAll"/>
        <security:intercept-url pattern="/agent-dashboard" access="permitAll"/>
        <security:intercept-url pattern="/customer-dashboard" access="permitAll"/>
        <security:intercept-url pattern="/policies-page" access="permitAll"/>
        <security:intercept-url pattern="/claims" access="permitAll"/>
        <security:intercept-url pattern="/file-claim" access="permitAll"/>
        <security:intercept-url pattern="/users-page" access="permitAll"/>
        
        <!-- ===== REST API ENDPOINTS (Backend JWT Validation) ===== -->
        
        <!-- Auth endpoints -->
        <security:intercept-url pattern="/auth/**" access="permitAll"/>
        
        <!-- User Management APIs -->
        <security:intercept-url pattern="/users" method="GET" access="hasRole('ADMIN') or hasRole('AGENT')"/>
        <security:intercept-url pattern="/users/*" method="GET" access="hasRole('ADMIN') or hasRole('AGENT')"/>
        <security:intercept-url pattern="/users" method="POST" access="hasRole('ADMIN')"/>
        <security:intercept-url pattern="/users/*" method="PUT" access="hasRole('ADMIN')"/>
        <security:intercept-url pattern="/users/*" method="DELETE" access="hasRole('ADMIN')"/>
        
        <!-- Policy Management APIs -->
        <security:intercept-url pattern="/policies" method="GET" access="isAuthenticated()"/>
        <security:intercept-url pattern="/policies/*" method="GET" access="isAuthenticated()"/>
        <security:intercept-url pattern="/policies" method="POST" access="hasRole('AGENT') or hasRole('ADMIN')"/>
        <security:intercept-url pattern="/policies/*" method="PUT" access="hasRole('AGENT') or hasRole('ADMIN')"/>
        <security:intercept-url pattern="/policies/*" method="DELETE" access="hasRole('ADMIN')"/>
        <security:intercept-url pattern="/policies/**" access="isAuthenticated()"/>
        
        <!-- Claim Management APIs -->
        <security:intercept-url pattern="/claims" method="GET" access="isAuthenticated()"/>
        <security:intercept-url pattern="/claims/*" method="GET" access="isAuthenticated()"/>
        <security:intercept-url pattern="/claims" method="POST" access="isAuthenticated()"/>
        <security:intercept-url pattern="/claims/*" method="PUT" access="hasRole('AGENT') or hasRole('ADMIN')"/>
        <security:intercept-url pattern="/claims/*" method="DELETE" access="hasRole('ADMIN')"/>
        <security:intercept-url pattern="/claims/**" access="isAuthenticated()"/>
        
        <!-- Dashboard Stats APIs -->
        <security:intercept-url pattern="/dashboard/**" access="isAuthenticated()"/>
        
        <!-- Default: Require authentication for everything else -->
        <security:intercept-url pattern="/**" access="isAuthenticated()"/>
        
        <!-- Disable CSRF for REST APIs -->
        <security:csrf disabled="true"/>
    </security:http>
    
    <!-- ===== JWT SECURITY BEANS ===== -->
    
    <!-- JWT Authentication Filter -->
    <bean id="jwtFilter" class="com.example.security.JwtAuthenticationFilter"/>
    
    <!-- JWT Entry Point (handles 401 errors) -->
    <bean id="jwtAuthEntryPoint" class="com.example.security.JwtAuthEntryPoint"/>
    
    <!-- Custom UserDetailsService -->
    <bean id="customUserDetailsService" class="com.example.security.CustomUserDetailsService"/>
    
    <!-- BCrypt Password Encoder -->
    <bean id="passwordEncoder" class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder">
        <constructor-arg value="12"/>
    </bean>
    
    <!-- Authentication Manager -->
    <security:authentication-manager alias="authenticationManager">
        <security:authentication-provider user-service-ref="customUserDetailsService">
            <security:password-encoder ref="passwordEncoder"/>
        </security:authentication-provider>
    </security:authentication-manager>
    
    <!-- ===== SPRING MVC CONFIGURATION ===== -->
    
    <!-- ✅ Custom ObjectMapper with JSR-310 support -->
    <bean id="objectMapper" class="com.fasterxml.jackson.databind.ObjectMapper"/>
    
    <!-- ✅ Register JavaTimeModule for LocalDate/LocalDateTime support -->
    <bean class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="objectMapper"/>
        <property name="targetMethod" value="registerModule"/>
        <property name="arguments">
            <list>
                <bean class="com.fasterxml.jackson.datatype.jsr310.JavaTimeModule"/>
            </list>
        </property>
    </bean>
    
    <!-- ✅ Disable writing dates as timestamps (use ISO-8601 format) -->
    <bean class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetObject" ref="objectMapper"/>
        <property name="targetMethod" value="configure"/>
        <property name="arguments">
            <list>
                <value type="com.fasterxml.jackson.databind.SerializationFeature">WRITE_DATES_AS_TIMESTAMPS</value>
                <value>false</value>
            </list>
        </property>
    </bean>
    
    <!-- ✅ Enable Spring MVC annotations with validation and custom ObjectMapper -->
    <mvc:annotation-driven validator="validator">
        <mvc:message-converters>
            <!-- JSON message converter with JSR-310 support -->
            <bean class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
                <property name="objectMapper" ref="objectMapper"/>
            </bean>
            <!-- String message converter -->
            <bean class="org.springframework.http.converter.StringHttpMessageConverter"/>
        </mvc:message-converters>
    </mvc:annotation-driven>
    
    <!-- ✅ Bean Validator for @Valid annotations -->
    <bean id="validator" class="org.springframework.validation.beanvalidation.LocalValidatorFactoryBean"/>
    
    <!-- Serve static resources -->
    <mvc:resources mapping="/static/**" location="/static/" cache-period="31556926" />
    <mvc:resources mapping="/css/**" location="/WEB-INF/views/css/" />
    <mvc:resources mapping="/js/**" location="/WEB-INF/views/js/" />
    <mvc:resources mapping="/images/**" location="/WEB-INF/views/images/" />

    <!-- Map simple pages without a controller -->
    <mvc:view-controller path="/" view-name="index" />
    <mvc:view-controller path="/login" view-name="Login" />
    <mvc:view-controller path="/register" view-name="register" />
    <mvc:view-controller path="/admin-dashboard" view-name="AdminDashboard" />
    <mvc:view-controller path="/agent-dashboard" view-name="agent-dashboard" />
    <mvc:view-controller path="/customer-dashboard" view-name="customer-dashboard" />
    <mvc:view-controller path="/policies-page" view-name="PolicyManagement" />
    <mvc:view-controller path="/claims" view-name="ClaimManagement" />
    <mvc:view-controller path="/file-claim" view-name="FileClaim" />
    <mvc:view-controller path="/users-page" view-name="UserManagement" />

    <!-- ===== DATABASE CONFIGURATION ===== -->
    
    <!-- PostgreSQL DataSource -->
    <bean id="dataSource" class="org.apache.commons.dbcp2.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="org.postgresql.Driver" />
        <property name="url" value="jdbc:postgresql://localhost:5432/hims" />
        <property name="username" value="postgres" />
        <property name="password" value="rootroot" />
        
        <!-- Connection pool settings -->
        <property name="initialSize" value="5" />
        <property name="maxTotal" value="50" />
        <property name="maxIdle" value="25" />
        <property name="minIdle" value="5" />
        <property name="maxWaitMillis" value="30000" />
    </bean>

    <!-- JPA EntityManagerFactory -->
    <bean id="entityManagerFactory" class="org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean">
        <property name="dataSource" ref="dataSource"/>
        <property name="packagesToScan" value="com.example.hims.entity"/>
        <property name="jpaVendorAdapter">
            <bean class="org.springframework.orm.jpa.vendor.HibernateJpaVendorAdapter">
                <property name="showSql" value="true"/>
                <property name="generateDdl" value="true"/>
                <property name="databasePlatform" value="org.hibernate.dialect.PostgreSQLDialect"/>
            </bean>
        </property>
        <property name="jpaProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto">update</prop>
                <prop key="hibernate.format_sql">true</prop>
                <prop key="hibernate.jdbc.batch_size">20</prop>
            </props>
        </property>
    </bean>

    <!-- JSP View Resolver -->
    <bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!-- JPA Transaction Manager -->
    <bean id="jpaTransactionManager" class="org.springframework.orm.jpa.JpaTransactionManager">
        <property name="entityManagerFactory" ref="entityManagerFactory"/>
    </bean>

    <!-- Enable @Transactional annotations -->
    <tx:annotation-driven transaction-manager="jpaTransactionManager" proxy-target-class="true"/>

</beans>
